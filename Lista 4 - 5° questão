class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def intercalar(p1, p2):
    inicio = None
    fim = None
    while p1 is not None and p2 is not None:
        if p1.valor <= p2.valor:
            menor = p1
            p1 = p1.prox
        else:
            menor = p2
            p2 = p2.prox
        menor.prox = None
        if inicio is None:
            inicio = menor
            fim = menor
        else:
            fim.prox = menor
            fim = menor
    if p1 is not None:
        if inicio is None:
            inicio = p1
        else:
            fim.prox = p1
    if p2 is not None:
        if inicio is None:
            inicio = p2
        else:
            fim.prox = p2
    return inicio

def imprimir_lista(p):
    atual = p
    while atual is not None:
        print(atual.valor, end=" -> ")
        atual = atual.prox
    print("None")

#Tempo de execução: O(n + m)
