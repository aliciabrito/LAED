class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def inverter_lista(p):
    anterior = None
    atual = p
    while atual is not None:
        proximo = atual.prox
        atual.prox = anterior
        anterior = atual
        atual = proximo
    return anterior

def imprimir_lista(p):
    atual = p
    while atual is not None:
        print(atual.valor, end=" -> ")
        atual = atual.prox
    print("None")
