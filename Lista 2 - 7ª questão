V = [2, 1, 9, 7, 6, 3, 9, 4, 2, 6, 1, 3]
k = 4
n = len(V)
achou = False
for i in range(n):
    limite = i + k
    if limite >= n:
        limite = n - 1
    for j in range(i + 1, limite + 1):
        if V[i] == V[j]:
            print("Sim, o", V[i])
            achou = True
            break
    if achou:
        break
if not achou:
    print("Não tem")

#Se k for constante, o algoritmo é O(n).
#Se k for próximo de n, então o algoritmo é O(n²) no pior caso.
