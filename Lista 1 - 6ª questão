lista = [9, 2, 7, 7, 2, 2, 1, 7, 7, 9]
menor_diferença = 999999
elemento1 = lista[0]
elemento2 = lista[1]
for i in range(len(lista)):
    for j in range(i + 1, len(lista)):
        if lista[i] > lista[j]:
            diferença = lista[i] - lista[j]
        else:
            diferença = lista[j] - lista[i]
        if diferença < menor_diferença:
            menor_diferença = diferença
            elemento1 = lista[i]
            elemento2 = lista[j]
print("Os elementos mais próximos são", elemento1, "e", elemento2, "com diferença", menor_diferenca)
