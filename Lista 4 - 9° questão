class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def possui_repetido(p):
    atual = p
    while atual is not None:
        aux = atual.prox
        while aux is not None:
            if atual.valor == aux.valor:
                return True
            aux = aux.prox
        atual = atual.prox
    return False

#Tempo de execução: O(n²)
