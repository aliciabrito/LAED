class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def remover_todas(p, k):
    while p is not None and p.valor == k:
        p = p.prox
    if p is None:
        return None
    anterior = p
    atual = p.prox
    while atual is not None:
        if atual.valor == k:
            anterior.prox = atual.prox
        else:
            anterior = atual
        atual = atual.prox
    return p

def imprimir_lista(p):
    atual = p
    while atual is not None:
        print(atual.valor, end=" -> ")
        atual = atual.prox
    print("None")

#Tempo de execução: O(n)
