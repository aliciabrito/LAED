class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def separar_pares_impares(p):
    pares = None
    fim_pares = None
    impares = None
    fim_impares = None
    atual = p
    while atual is not None:
        proximo = atual.prox
        atual.prox = None
        if atual.valor % 2 == 0:
            if pares is None:
                pares = atual
                fim_pares = atual
            else:
                fim_pares.prox = atual
                fim_pares = atual
        else:
            if impares is None:
                impares = atual
                fim_impares = atual
            else:
                fim_impares.prox = atual
                fim_impares = atual
        atual = proximo
    return pares, impares

def imprimir_lista(p):
    atual = p
    while atual is not None:
        print(atual.valor, end=" -> ")
        atual = atual.prox
    print("None")

