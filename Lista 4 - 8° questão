class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def elemento_mais_frequente(p):
    if p is None:
        return None, 0
    maior_elemento = p.valor
    maior_quantidade = 0
    atual = p
    while atual is not None:
        quantidade = 0
        aux = p
        while aux is not None:
            if aux.valor == atual.valor:
                quantidade += 1
            aux = aux.prox
        if quantidade > maior_quantidade:
            maior_quantidade = quantidade
            maior_elemento = atual.valor
        atual = atual.prox
    return maior_elemento, maior_quantidade

#Tempo de execução: O(n²)
