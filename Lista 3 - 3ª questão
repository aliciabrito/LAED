def mediana_duas_listas(U, V):
    n = len(U)
    inicio = 0
    fim = n  
    while inicio <= fim:
        i = (inicio + fim) // 2
        j = n - i    
        U_esq = U[i-1] if i > 0 else float('-inf')
        U_dir = U[i]   if i < n else float('inf')
        V_esq = V[j-1] if j > 0 else float('-inf')
        V_dir = V[j]   if j < n else float('inf')     
        if U_esq <= V_dir and V_esq <= U_dir:
            maior_esquerda = max(U_esq, V_esq)
            menor_direita = min(U_dir, V_dir)
            return (maior_esquerda + menor_direita) / 2
        if U_esq > V_dir:
            fim = i - 1
        else:
            inicio = i + 1

# Teste
U = [1, 3, 6, 7, 10]
V = [11, 15, 17, 19, 21]
print(mediana_duas_listas(U, V))
