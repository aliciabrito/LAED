class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

def criar_lista(valores):
    inicio = None
    fim = None
    for valor in valores:
        novo = No(valor)
        if inicio is None:
            inicio = novo
            fim = novo
        else:
            fim.prox = novo
            fim = novo
    return inicio

def duplicar_impares(p):
    atual = p
    while atual is not None:
        if atual.valor % 2 != 0:
            novo = No(atual.valor)
            novo.prox = atual.prox
            atual.prox = novo
            atual = novo.prox
        else:
            atual = atual.prox
        return p

def imprimir_lista(p):
    atual = p
    while atual is not None:
        print(atual.valor, end=" -> ")
        atual = atual.prox
    print("None")

#Tempo de execução: O(n)
